<Page x:Class="ProjectPV178.Views.HomePagePatient"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectPV178.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="500"
      Title="HomePagePatient">


    <Grid Background="White">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="1" Orientation="Vertical" Grid.Row="1">
            <Calendar SelectedDatesChanged="SelectedDate_SelectedDatesChanged" Margin="5" Name="SelectedDate" />
            <Label Content="Choose depratment:" Padding="5,0,0,0"/>

            <ComboBox x:Name="DepartmentComboBox" DisplayMemberPath="Name" Margin="5" ItemsSource="{Binding Departments}"  SelectionChanged="DepartmentComboBox_SelectionChanged"/>
            <Label x:Name="DepLabel" Margin="5" UseLayoutRounding="False"/>
        </StackPanel>
        
        <StackPanel Margin="0,0,10,0" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Label Grid.Row="0" Width="130" Grid.Column="1" Padding="0,0,5,0" HorizontalAlignment="Right" Content="Logged in as:" HorizontalContentAlignment="Right"/>
            <Label Grid.Row="0" Width="130" Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" HorizontalContentAlignment="Right">
                <TextBlock Text="{Binding NameString}"
                   TextWrapping="Wrap" TextAlignment="Right" />
            </Label>
            <Button Content="Log out" Width="50" HorizontalAlignment="Right" Click="Button_Logout"/>
        </StackPanel>
        <TabControl Grid.RowSpan="2" Grid.Column="0">
            <TabItem Header="Reservations">
                <StackPanel Orientation="Vertical">
                    <WrapPanel>
                        <Label Content="Selected date:"/>
                        <Label Content="{Binding ElementName=SelectedDate, Path=SelectedDate, StringFormat=d, UpdateSourceTrigger=PropertyChanged }"/>
                    </WrapPanel>
                    <DataGrid CanUserAddRows="False" SelectionChanged="DataGrid1_SelectionChanged" x:Name="DataGrid1" Grid.Row="1" ItemsSource="{Binding Day, UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}"/>
                            <DataGridCheckBoxColumn Header="Reserved" Binding="{Binding IsReserved,Mode=OneWay}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Label Content="{Binding ReservationInfo, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Reserve" Click="Reserve"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="My Reservations">
                <StackPanel>
                    <DataGrid CanUserAddRows="False" x:Name="DataGrid2" Grid.Row="1" ItemsSource="{Binding MyReservations, UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Department" Binding="{Binding DepartmentID}"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Label Content="{Binding MyReservationInfo, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Remove" Click="Remove" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
