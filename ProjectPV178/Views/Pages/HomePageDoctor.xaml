<Page x:Class="ProjectPV178.Views.Pages.HomePageDoctor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectPV178.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="500"
      Title="HomePageDoctor">

    <Grid Background="White">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="1" Orientation="Vertical" Grid.Row="1">
            <Calendar SelectedDatesChanged="SelectedDate_SelectedDatesChanged" Margin="5" Name="SelectedDate"/>
            <Label Content="Choose depratment:" Padding="5,0,0,0"/>
            <ComboBox x:Name="DepartmentComboBox" DisplayMemberPath="Name" Margin="5" ItemsSource="{Binding Departments,UpdateSourceTrigger=PropertyChanged}"  SelectionChanged="DepartmentComboBox_SelectionChanged"/>
            <Label x:Name="DepLabel" Margin="5" UseLayoutRounding="False"/>
        </StackPanel>
        
        <StackPanel Margin="0,0,10,0" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Label Grid.Row="0" Width="130" Grid.Column="1" Padding="0,0,5,0" HorizontalAlignment="Right" Content="Logged in as:" HorizontalContentAlignment="Right"/>
            <Label Grid.Row="0" Width="130" Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" HorizontalContentAlignment="Right">
                <TextBlock Text="{Binding NameString}" TextWrapping="Wrap" TextAlignment="Right" />
            </Label>
            <Button Content="Log out" Width="50" HorizontalAlignment="Right" Click="Button_Logout"/>
        </StackPanel>

        <TabControl Grid.RowSpan="2" Grid.Column="0">
            <TabItem Header="Upcoming">
                <StackPanel>
                    <DataGrid CanUserAddRows="False" SelectionChanged="DataGridUpcoming_SelectionChanged" x:Name="DataGridUpcoming" Grid.Row="1" ItemsSource="{Binding Day, UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}"/>
                            <DataGridCheckBoxColumn Header="Reserved" Binding="{Binding IsReserved,Mode=OneWay}"/>
                            <DataGridTextColumn Header="Patient name" Binding="{Binding Reservation.Patient.Name}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Label Content="{Binding ReservationInfo, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Remove" Margin="5,5,5,5" Padding="3,3,3,3" FontSize="10" Click="Button_RemoveUpcoming"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="My Departments">
                <StackPanel>
                    <Label Content="Assign to new department:" Padding="5,0,0,0" UseLayoutRounding="True"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="AssignDep" DisplayMemberPath="Name" Margin="5" ItemsSource="{Binding Departments,UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Assign" Margin="5,5,5,5" Padding="3,3,3,3" FontSize="10" Click="Button_Assign"/>
                    </Grid>

                    <Label Content="My departments:" Padding="5,10,0,0" UseLayoutRounding="True"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="MyDepartmentComboBox" DisplayMemberPath="Name" Margin="5" ItemsSource="{Binding MyDepartments,UpdateSourceTrigger=PropertyChanged}"  SelectionChanged="MyDepartmentComboBox_SelectionChanged"/>
                        <Button Grid.Column="1" Content="Remove" Margin="5,5,5,5" Padding="3,3,3,3" FontSize="10" Click="Button_Remove"/>
                    </Grid>
                    <Label x:Name="MyDepLabel" Margin="5" UseLayoutRounding="False"/>
                </StackPanel>

            </TabItem>
            <TabItem Header="Edit working hours">
                <StackPanel>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <DatePicker x:Name="DayOffDatePicker" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="Take a day off" Click="Button_DayOff"/>
                    </Grid>
                    <Label Content="My days off:"/>
                    <DataGrid CanUserAddRows="False" x:Name="MyDaysOffDataGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding .}"/>
                            
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>
        </TabControl>


    </Grid>
</Page>
