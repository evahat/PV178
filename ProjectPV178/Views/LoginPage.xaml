<Page x:Class="ProjectPV178.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectPV178.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="500"
      Title="LoginPage">

    <Grid Background="white">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="Reservation system" FontFamily="Microsoft Sans Serif" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center">
            <StackPanel Margin="20" Orientation="Vertical" Grid.Row="1">
                <Label Content="Username:" Padding="0" Margin="10,0,10,0"/>
                <TextBox Margin="10,0,10,0" Height="20" Width="80" HorizontalAlignment="Left"/>
                <Label Content="Password:" Padding="0" Margin="10,0,10,0"/>
                <PasswordBox Margin="10,0,10,0" Height="20" Width="80" HorizontalAlignment="Left"/>
                <Button Margin="10" Content="Login" Height="30" Width="60" Click="Button_Click" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Margin="20" Orientation="Vertical" Grid.Row="1">
                <Label Content="Username:" Padding="0" Margin="10,0,10,0"/>
                <TextBox Margin="10,0,10,0" Height="20" Width="80" HorizontalAlignment="Left"/>
                <Label Content="Password:" Padding="0" Margin="10,0,10,0"/>
                <PasswordBox Margin="10,0,10,0" Height="20" Width="80" HorizontalAlignment="Left"/>
                <Button Margin="10" Content="Sign up" Height="30" Width="60" Click="Button_Click" HorizontalAlignment="Left"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
