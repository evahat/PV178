<Page x:Class="ProjectPV178.Views.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjectPV178.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page1">


    <Grid Background="White">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="1" Orientation="Vertical" Grid.Row="1">

            <Calendar Margin="5"/>
            <ComboBox Margin="5" ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}"/>
            <Label Margin="5" x:Name="docName" Content="{Binding SelectedDepartment}" UseLayoutRounding="False"/>
        </StackPanel>
        <Button Grid.Column="1" Grid.Row ="0" Content="Log in" Margin="10" Height="40" FontSize="16" Click="Button_Click"/>
        <DataGrid x:Name="DataGrid1" Grid.Row="1" ItemsSource="{Binding Reservations}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}"/>
                <DataGridCheckBoxColumn Header="Reserved" Binding="{Binding IsReserved}"/>
                <DataGridTextColumn Header="Patient name" ></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Grid.Column ="0" Grid.Row="0" Content="Upcoming patients" HorizontalAlignment="Left" Height="40" Margin="10" Padding="10" VerticalAlignment="Center"  Click="Button_Click_1"/>
            <Button Grid.Column ="0" Grid.Row="0" Content="Export" HorizontalAlignment="Left" Height="40" Margin="10" Padding="10" VerticalAlignment="Center"  Click="Button_Click_1"/>
            <Button Grid.Column ="0" Grid.Row="0" Content="Edit working hours" HorizontalAlignment="Left" Height="40" Margin="10" Padding="10" VerticalAlignment="Center"  Click="Button_Click_1"/>
        </StackPanel>

    </Grid>
</Page>
